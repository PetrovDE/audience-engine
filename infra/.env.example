# Base reference template.
# Use `infra/.env.local` for local development bootstrap.
# Use `infra/.env.prod.example` to create `infra/.env.prod` for server deployment.
# Shared runtime settings
TZ=UTC

# External Ollama endpoint (NOT managed by Docker Compose in this repo).
# Containers (for example Airflow services) should use host.docker.internal on Docker Desktop.
# Host-side scripts can override to http://localhost:11434 in their shell if needed.
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL_VERSION=nomic-embed-text

# Postgres
POSTGRES_DB=audience_engine
POSTGRES_USER=audience_engine
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
EXPORT_POSTGRES_HOST=postgres
EXPORT_POSTGRES_PORT=5432
EXPORT_POSTGRES_DB=audience_engine
EXPORT_POSTGRES_USER=audience_engine
EXPORT_POSTGRES_PASSWORD=change_me
EXPORT_POSTGRES_SCHEMA=public
EXPORT_POSTGRES_TABLE=audience_export_staging
EXPORT_POSTGRES_SSLMODE=

# ClickHouse
CLICKHOUSE_DB=audience_engine
CLICKHOUSE_USER=audience_engine
CLICKHOUSE_PASSWORD=change_me
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_FEATURE_SLICE_QUERY="SELECT customer_id, fs_version, policy_version, customer_age_years, customer_tenure_months, credit_score_band, delinquency_12m_count, utilization_ratio_avg_3m, card_spend_total_3m, digital_engagement_score, is_employee_flag, do_not_contact_flag, opt_out_flag, legal_suppression_flag, region_code, segment_id, product_line FROM feature_mart_snapshot"
CLICKHOUSE_FEATURE_SLICE_LIMIT=5000
INTEGRATION_READINESS_PROBE_TIMEOUT_SECONDS=2.0

# Redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_EMBEDDING_CACHE_ENABLED=1
REDIS_EMBEDDING_CACHE_PREFIX=ae:emb_cache
REDIS_EMBEDDING_CACHE_TTL_SECONDS=86400

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_please
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_please
MINIO_BUCKET=audience-engine
MINIO_SECURE=0
MINIO_API_PORT=9001
MINIO_CONSOLE_PORT=9002

# Qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_ALIAS=audience-serving

# Retrieval/API RBAC (comma-separated API keys)
AE_CAMPAIGN_API_KEYS=campaign_local_key
AE_ML_ANALYST_API_KEYS=
AE_DATA_ENGINEER_API_KEYS=
AE_ADMIN_API_KEYS=admin_local_key

# User/role admin bootstrap (local/dev)
AE_BOOTSTRAP_ADMIN_USERNAME=admin
AE_BOOTSTRAP_ADMIN_DISPLAY_NAME=Admin Operator
AE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AE_BOOTSTRAP_ADMIN_PASSWORD=change_me_please
AE_OPERATOR_SESSION_SECRET=replace_with_long_random_operator_session_secret

# Operator UI login (for local/development convenience)
OPERATOR_UI_USERNAME=admin
OPERATOR_UI_PASSWORD=203217

# Airflow 3
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=replace_with_32_urlsafe_base64_key
AIRFLOW_API_AUTH_JWT_SECRET=replace_with_long_random_string
AIRFLOW_API_AUTH_JWT_ISSUER=audience-engine-airflow
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Grafana / Prometheus
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
