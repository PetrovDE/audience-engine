# Local development bootstrap only.
# NOT for production. Credentials here are intentionally convenient for local Docker Desktop usage.

TZ=UTC

# External Ollama endpoint for containers in Docker Desktop.
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL_VERSION=nomic-embed-text

# Postgres
POSTGRES_DB=audience_engine
POSTGRES_USER=audience_engine
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# ClickHouse
CLICKHOUSE_DB=audience_engine
CLICKHOUSE_USER=audience_engine
CLICKHOUSE_PASSWORD=change_me
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# Redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_EMBEDDING_CACHE_ENABLED=1
REDIS_EMBEDDING_CACHE_PREFIX=ae:emb_cache
REDIS_EMBEDDING_CACHE_TTL_SECONDS=86400

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_please
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_please
MINIO_BUCKET=audience-engine
MINIO_SECURE=0
MINIO_API_PORT=9001
MINIO_CONSOLE_PORT=9002

# Qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_ALIAS=audience-serving

# Airflow 3 (local bootstrap)
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=Jf1OwBZ6ofRwSEopgI0GhBSPYBQ2PBBkKSOhzNidUDY=
AIRFLOW_API_AUTH_JWT_SECRET=local-dev-jwt-secret
AIRFLOW_API_AUTH_JWT_ISSUER=audience-engine-airflow-local
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=203217
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Grafana / Prometheus
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=203217
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
