# AudienceEngine host-run environment for RedOS systemd service.
# Copy to /etc/audience-engine/audience-engine.env and replace placeholders.
# This file is for the host-run app process.
# Do not use compose-internal DNS names such as postgres/qdrant/redis/minio/clickhouse here.

TZ=UTC

# External model endpoint (service is not managed by this compose stack).
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL_VERSION=nomic-embed-text

# Host-run app reaches containerized infra through host-published ports.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_ALIAS=audience-serving

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=audience_engine
POSTGRES_USER=audience_engine
POSTGRES_PASSWORD=replace_with_postgres_password
POSTGRES_SSLMODE=

EXPORT_POSTGRES_HOST=127.0.0.1
EXPORT_POSTGRES_PORT=5432
EXPORT_POSTGRES_DB=audience_engine
EXPORT_POSTGRES_USER=audience_engine
EXPORT_POSTGRES_PASSWORD=replace_with_export_postgres_password
EXPORT_POSTGRES_SCHEMA=public
EXPORT_POSTGRES_TABLE=audience_export_staging
EXPORT_POSTGRES_SSLMODE=

CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=audience_engine
CLICKHOUSE_USER=audience_engine
CLICKHOUSE_PASSWORD=replace_with_clickhouse_password
CLICKHOUSE_FEATURE_SLICE_QUERY="SELECT customer_id, fs_version, policy_version, customer_age_years, customer_tenure_months, credit_score_band, delinquency_12m_count, utilization_ratio_avg_3m, card_spend_total_3m, digital_engagement_score, is_employee_flag, do_not_contact_flag, opt_out_flag, legal_suppression_flag, region_code, segment_id, product_line FROM feature_mart_snapshot"
CLICKHOUSE_FEATURE_SLICE_LIMIT=5000
INTEGRATION_READINESS_PROBE_TIMEOUT_SECONDS=2.0

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_EMBEDDING_CACHE_ENABLED=1
REDIS_EMBEDDING_CACHE_PREFIX=ae:emb_cache
REDIS_EMBEDDING_CACHE_TTL_SECONDS=86400

MINIO_ENDPOINT=127.0.0.1:9001
MINIO_ACCESS_KEY=replace_with_minio_access_key
MINIO_SECRET_KEY=replace_with_minio_secret_key
MINIO_BUCKET=audience-engine
MINIO_SECURE=0
MINIO_FEATURE_MART_PREFIX=minimal_slice/feature_mart
MINIO_EXPORT_PREFIX=minimal_slice/exports

FEATURE_SLICE_SOURCE=snapshot

# Retrieval/API RBAC keys.
AE_CAMPAIGN_API_KEYS=replace_with_campaign_api_key
AE_ML_ANALYST_API_KEYS=
AE_DATA_ENGINEER_API_KEYS=
AE_ADMIN_API_KEYS=replace_with_admin_api_key

# Operator bootstrap/session settings.
AE_BOOTSTRAP_ADMIN_USERNAME=admin
AE_BOOTSTRAP_ADMIN_DISPLAY_NAME=Admin Operator
AE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AE_BOOTSTRAP_ADMIN_PASSWORD=replace_with_bootstrap_admin_password
AE_OPERATOR_SESSION_SECRET=replace_with_long_random_operator_session_secret

# Local operator UI fallback login (optional, but set explicitly).
OPERATOR_UI_USERNAME=replace_with_operator_ui_username
OPERATOR_UI_PASSWORD=replace_with_operator_ui_password
