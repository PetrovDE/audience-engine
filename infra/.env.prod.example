# Production-shaped environment template.
# Copy this file to `infra/.env.prod` and replace every placeholder before deployment.
# Do not commit real secrets.

TZ=UTC

# External Ollama endpoint (service is external to compose).
OLLAMA_BASE_URL=http://ollama.internal:11434
EMBEDDING_MODEL_VERSION=nomic-embed-text

# Postgres
POSTGRES_DB=audience_engine
POSTGRES_USER=audience_engine
POSTGRES_PASSWORD=replace_with_postgres_password
POSTGRES_PORT=5432

# ClickHouse
CLICKHOUSE_DB=audience_engine
CLICKHOUSE_USER=audience_engine
CLICKHOUSE_PASSWORD=replace_with_clickhouse_password
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# Redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=replace_with_redis_password_or_leave_empty
REDIS_EMBEDDING_CACHE_ENABLED=1
REDIS_EMBEDDING_CACHE_PREFIX=ae:emb_cache
REDIS_EMBEDDING_CACHE_TTL_SECONDS=86400

# MinIO
MINIO_ROOT_USER=audience_engine_minio_admin
MINIO_ROOT_PASSWORD=replace_with_minio_root_password
MINIO_ACCESS_KEY=audience_engine_minio_app
MINIO_SECRET_KEY=replace_with_minio_app_secret
MINIO_BUCKET=audience-engine
MINIO_SECURE=0
MINIO_API_PORT=9001
MINIO_CONSOLE_PORT=9002

# Qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_ALIAS=audience-serving

# Airflow 3
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=replace_with_unique_32_byte_urlsafe_base64_key
AIRFLOW_API_AUTH_JWT_SECRET=replace_with_airflow_jwt_secret
AIRFLOW_API_AUTH_JWT_ISSUER=audience-engine-airflow
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USERNAME=airflow_admin
AIRFLOW_ADMIN_PASSWORD=replace_with_airflow_admin_password
AIRFLOW_ADMIN_EMAIL=airflow-admin@example.com

# Grafana / Prometheus
GRAFANA_ADMIN_USER=grafana_admin
GRAFANA_ADMIN_PASSWORD=replace_with_grafana_admin_password
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
